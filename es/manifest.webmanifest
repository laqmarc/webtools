{
  "name": "WebTools — Convierte, comprime e inspecciona — sin subir nada",
  "short_name": "WebTools",
  "description": "Convierte y comprime imágenes, SVG y PDF, y trabaja con JSON, CSV, YAML y texto. Todo se ejecuta en tu navegador: ningún archivo se envía a ningún servidor.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f1115",
  "theme_color": "#161922",
  "categories": [
    "utilities",
    "productivity",
    "photo"
  ],
  "icons": [
    {
      "src": "../icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "../icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Comprimir imágenes",
      "short_name": "Comprimir imágenes",
      "description": "Baja el peso por calidad o hasta un tamaño concreto.",
      "url": "./comprimir-imagenes/"
    },
    {
      "name": "PNG a WebP",
      "short_name": "PNG a WebP",
      "description": "Convierte imágenes PNG a WebP por lotes, dentro del navegador.",
      "url": "./png-a-webp/"
    },
    {
      "name": "Unir PDF",
      "short_name": "Unir PDF",
      "description": "Pega varios PDF en uno solo, en el orden que quieras.",
      "url": "./unir-pdf/"
    },
    {
      "name": "Formatear y validar JSON",
      "short_name": "Formatear y validar JSON",
      "description": "Indenta, minifica u ordena claves, y señala el error con línea y columna.",
      "url": "./formatear-json/"
    }
  ],
  "file_handlers": [
    {
      "action": "./convertir-imagenes/",
      "accept": {
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/avif": [
          ".avif"
        ]
      }
    },
    {
      "action": "./optimizar-svg/",
      "accept": {
        "image/svg+xml": [
          ".svg"
        ]
      }
    },
    {
      "action": "./unir-pdf/",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ]
}
